# Every key the app reads. Public values only: EXPO_PUBLIC_* values are inlined into the app bundle, where anyone
# can read them. Copy to .env (git-ignored); new workspaces copy the repository root's .env (see .conductor/).

# The API the app talks to. The local mock (npm run mock-api) listens on 4010; the iOS simulator reaches it as
# localhost, the Android emulator after `adb reverse tcp:4010 tcp:4010` (npm run e2e does that for you).
EXPO_PUBLIC_API_URL=http://localhost:4010
# Path prefix in front of every endpoint.
EXPO_PUBLIC_API_PREFIX=/api/v1
# Requests per second the client lets through; set it to the backend's limit.
EXPO_PUBLIC_API_RATE_PER_SECOND=5

# Build-time only, never committed: a QA screenshot tour (src/dev/qa-tour.ts) and its test account.
# EXPO_PUBLIC_QA_TOUR=1
# EXPO_PUBLIC_QA_EMAIL=
# EXPO_PUBLIC_QA_PASSWORD=
